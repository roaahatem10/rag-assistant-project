# Copy this file to ".env" in the backend/ folder and adjust if needed.
# The real ".env" is git-ignored and must never be committed.

# Where the persisted Chroma vector store (built by the notebook) lives.
VECTOR_STORE_DIR=./data/vector_store
CHROMA_COLLECTION_NAME=study_assistant_docs

# Must match the embedding model used in notebooks/rag_pipeline.ipynb.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Local Ollama server + model to use for generation.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# How many chunks to retrieve per question.
TOP_K=4

# Comma-separated list of origins allowed to call this API (CORS).
FRONTEND_ORIGINS=http://localhost:8501
